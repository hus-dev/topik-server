# Production environment variables for AWS EC2 deployment

# Database Configuration
MYSQL_ROOT_PASSWORD=change_me_secure_root_password
MYSQL_DATABASE=topik_smart_academy
MYSQL_USER=topik_user
MYSQL_PASSWORD=change_me_secure_user_password

# Prisma Database URL - Update with your actual host
# For local Docker MySQL: mysql://topik_user:password@localhost:3306/topik_smart_academy
# For AWS RDS: mysql://topik_user:password@your-rds-endpoint:3306/topik_smart_academy
DATABASE_URL=mysql://topik_user:change_me_secure_user_password@mysql:3306/topik_smart_academy

# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=change_me_to_a_strong_random_jwt_secret_at_least_32_chars

# Google Social Login
# Single client:
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Multiple clients (web/android/ios): comma-separated
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Optional: For production environment
NODE_ENV=production
PORT=3000

# Media (AWS S3 + CloudFront CDN)
# CloudFront 배포 도메인(예: https://dxxxxxxxxxxxx.cloudfront.net)을 설정하면
# 시드/마이그레이션이 DB에 절대 CDN URL을 저장한다.
MEDIA_CDN_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net
# EC2 프로덕션에서는 Node.js 정적 파일 서빙을 비활성화한다.
SERVE_LOCAL_MEDIA=false
# scripts/upload-media-to-s3.ts 에서 사용 (EC2는 인스턴스 프로파일 IAM 권장)
S3_MEDIA_BUCKET=topik-media-prod
AWS_REGION=ap-northeast-2