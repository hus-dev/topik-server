generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model users {
  id                 String               @id @default(uuid()) @db.VarChar(36)
  email              String?              @unique @db.VarChar(255)
  password_hash      String?              @db.VarChar(255)
  provider           String               @db.VarChar(20)
  provider_id        String?
  nickname           String               @db.VarChar(100)
  target_level       Int                  @db.TinyInt
  language_code      String               @db.VarChar(10)
  timezone           String               @db.VarChar(100)
  timer_mode         String               @db.VarChar(20)
  font_scale         Decimal              @default(1.00) @db.Decimal(3, 2)
  theme_color        String               @default("mint") @db.VarChar(30)
  home_layout        Int                  @default(1) @db.TinyInt
  practice_layout    Int                  @default(1) @db.TinyInt
  created_at         BigInt
  updated_at         BigInt
  role               String               @default("user") @db.VarChar(20)
  exam_sessions      exam_sessions[]
  sync_queue         sync_queue[]
  user_downloads     user_downloads[]
  user_grammar_items user_grammar_items[]
  user_vocabulary    user_vocabulary[]
  user_questions     user_questions[]

  @@unique([provider, provider_id], map: "uq_users_provider_pid")
  @@index([email], map: "idx_users_email")
}

model answers {
  id              String        @id @default(uuid()) @db.VarChar(36)
  session_id      String        @db.VarChar(36)
  question_id     String        @db.VarChar(36)
  selected_answer String?       @db.VarChar(1000)
  text_answer     String?       @db.VarChar(4000)
  is_correct      Int?          @db.TinyInt
  spent_seconds   Int           @default(0)
  bookmarked      Int           @default(0) @db.TinyInt
  updated_at      BigInt
  exam_sessions   exam_sessions @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "answers_ibfk_1")
  questions       questions     @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "answers_ibfk_2")

  @@unique([session_id, question_id], map: "uq_answers_session_q")
  @@index([question_id], map: "question_id")
}

model exam_sessions {
  id                String         @id @default(uuid()) @db.VarChar(36)
  user_id           String         @db.VarChar(36)
  mode              String         @db.VarChar(20)
  section           String         @db.VarChar(20)
  set_id            String?        @db.VarChar(36)
  total_questions   Int
  current_index     Int            @default(0)
  remaining_seconds Int
  status            String         @db.VarChar(20)
  started_at        BigInt
  submitted_at      BigInt?
  answers           answers[]
  users             users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "exam_sessions_ibfk_1")
  question_sets     question_sets? @relation(fields: [set_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "exam_sessions_ibfk_2")

  @@index([user_id, status], map: "idx_sessions_user_status")
  @@index([set_id], map: "set_id")
}

model grammar_items {
  id                 String               @id @default(uuid()) @db.VarChar(36)
  pattern            String               @db.VarChar(255)
  description        String               @db.VarChar(4000)
  examples_json      Json
  tags_json          Json
  is_downloaded      Int                  @default(0) @db.TinyInt
  updated_at         BigInt
  user_grammar_items user_grammar_items[]
}

model question_sets {
  id                String               @id @default(uuid()) @db.VarChar(36)
  title             String?              @db.VarChar(255)
  section           String               @db.VarChar(20)
  level             Int                  @db.TinyInt
  created_at        BigInt
  updated_at        BigInt
  exam_kind         String               @default("practice") @db.VarChar(20)
  total_questions   Int                  @default(0)
  duration_seconds  Int                  @default(0)
  price             Int                  @default(0)
  is_free           Int                  @default(0) @db.TinyInt
  display_order     Int                  @default(0)
  exam_sessions     exam_sessions[]
  questions         questions[]
  explanationVideos explanation_videos[]
}

model topik_exam_schedules {
  id                    String @id @default(uuid()) @db.VarChar(36)
  exam_name             String @db.VarChar(255)
  exam_date             BigInt
  registration_start_at BigInt
  registration_end_at   BigInt
  result_date           BigInt
  location              String @db.VarChar(255)
  fee                   Int
  registration_url      String @db.VarChar(500)
  is_active             Int    @default(1) @db.TinyInt
  display_order         Int    @default(0)
  created_at            BigInt
  updated_at            BigInt

  @@index([is_active, exam_date], map: "idx_topik_exam_schedules_active_exam_date")
  @@index([display_order, exam_date], map: "idx_topik_exam_schedules_order_date")
}

model questions {
  id                 String               @id @default(uuid()) @db.VarChar(36)
  set_id             String?              @db.VarChar(36)
  passage_id         String?              @db.VarChar(36)
  section            String               @db.VarChar(20)
  question_type      String               @db.VarChar(50)
  question_number    Int
  level              Int?                 @db.TinyInt
  prompt             String               @db.VarChar(4000)
  correct_answer     String?              @db.VarChar(1000)
  explanation        String?              @db.VarChar(4000)
  ai_explanation     String?              @db.VarChar(4000)
  difficulty         Int?                 @db.TinyInt
  time_limit_seconds Int?
  is_ai_generated    Int                  @default(0) @db.TinyInt
  is_downloaded      Int                  @default(0) @db.TinyInt
  created_at         BigInt
  updated_at         BigInt
  answers            answers[]
  user_questions     user_questions[]
  question_media     question_media[]
  question_options   question_options[]
  question_sets      question_sets?       @relation(fields: [set_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "questions_ibfk_1")
  question_passages  question_passages?   @relation(fields: [passage_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "questions_ibfk_2")
  explanationVideos  explanation_videos[]

  @@index([set_id], map: "set_id")
  @@index([passage_id], map: "passage_id")
  @@index([section, question_type, level], map: "idx_questions_section_type_level")
}

model question_options {
  id            String    @id @default(uuid()) @db.VarChar(36)
  question_id   String    @db.VarChar(36)
  option_number Int
  content       String    @db.VarChar(1000)
  is_correct    Int       @default(0) @db.TinyInt
  questions     questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "question_options_ibfk_1")

  @@unique([question_id, option_number], map: "uq_question_options_question_number")
}

model question_passages {
  id          String      @id @default(uuid()) @db.VarChar(36)
  title       String?     @db.VarChar(255)
  content     String      @db.Text
  translation String?     @db.Text
  created_at  BigInt
  updated_at  BigInt
  questions   questions[]
}

model question_media {
  id               String    @id @default(uuid()) @db.VarChar(36)
  question_id      String    @db.VarChar(36)
  media_type       String    @db.VarChar(20)
  url              String    @db.VarChar(500)
  duration_seconds Int?
  transcript       String?   @db.VarChar(4000)
  sort_order       Int       @default(1)
  created_at       BigInt
  updated_at       BigInt
  questions        questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "question_media_ibfk_1")

  @@index([question_id], map: "question_id")
}

model explanation_videos {
  id             String         @id @default(uuid()) @db.VarChar(36)
  title          String         @db.VarChar(255)
  description    String         @db.Text
  thumbnail_url  String?        @db.VarChar(500)
  video_url      String         @db.VarChar(500)
  question_id    String?        @db.VarChar(36)
  set_id         String?        @db.VarChar(36)
  section        String?        @db.VarChar(20)
  level          Int?           @db.TinyInt
  is_recommended Int            @default(0) @db.TinyInt
  display_order  Int            @default(0)
  created_at     BigInt
  updated_at     BigInt
  questions      questions?     @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "explanation_videos_ibfk_1")
  question_sets  question_sets? @relation(fields: [set_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "explanation_videos_ibfk_2")

  @@index([is_recommended, display_order], map: "idx_explanation_videos_recommended_order")
  @@index([section, level], map: "idx_explanation_videos_section_level")
  @@index([question_id], map: "idx_explanation_videos_question_id")
  @@index([set_id], map: "idx_explanation_videos_set_id")
}

model sync_queue {
  id           String @id @default(uuid()) @db.VarChar(36)
  user_id      String @db.VarChar(36)
  entity_type  String @db.VarChar(50)
  entity_id    String @db.VarChar(36)
  action       String @db.VarChar(20)
  payload_json Json
  status       String @db.VarChar(20)
  retry_count  Int    @default(0)
  created_at   BigInt
  updated_at   BigInt
  users        users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sync_queue_ibfk_1")

  @@index([user_id, status, created_at], map: "idx_sync_user_status_created")
}

model user_downloads {
  id          String @id @default(uuid()) @db.VarChar(36)
  user_id     String @db.VarChar(36)
  entity_type String @db.VarChar(20)
  entity_id   String @db.VarChar(36)
  status      String @default("downloaded") @db.VarChar(20)
  created_at  BigInt
  updated_at  BigInt
  users       users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_downloads_ibfk_1")

  @@unique([user_id, entity_type, entity_id], map: "uq_user_downloads_user_entity")
  @@index([user_id, status, updated_at], map: "idx_user_downloads_user_status_updated")
  @@index([entity_type, entity_id], map: "idx_user_downloads_entity")
}

model user_grammar_items {
  id              String        @id @default(uuid()) @db.VarChar(36)
  user_id         String        @db.VarChar(36)
  grammar_item_id String        @db.VarChar(36)
  is_bookmarked   Int           @default(0) @db.TinyInt
  updated_at      BigInt
  users           users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_grammar_items_ibfk_1")
  grammar_items   grammar_items @relation(fields: [grammar_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_grammar_items_ibfk_2")

  @@unique([user_id, grammar_item_id], map: "uq_user_grammar_user_item")
  @@index([grammar_item_id], map: "grammar_item_id")
}

model user_vocabulary {
  id            String     @id @default(uuid()) @db.VarChar(36)
  user_id       String     @db.VarChar(36)
  vocabulary_id String     @db.VarChar(36)
  is_bookmarked Int        @default(0) @db.TinyInt
  updated_at    BigInt
  users         users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_vocabulary_ibfk_1")
  vocabulary    vocabulary @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_vocabulary_ibfk_2")

  @@unique([user_id, vocabulary_id], map: "uq_user_vocabulary_user_vocab")
  @@index([vocabulary_id], map: "vocabulary_id")
}

model user_questions {
  id            String    @id @default(uuid()) @db.VarChar(36)
  user_id       String    @db.VarChar(36)
  question_id   String    @db.VarChar(36)
  is_bookmarked Int       @default(0) @db.TinyInt
  updated_at    BigInt
  users         users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_questions_ibfk_1")
  questions     questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_questions_ibfk_2")

  @@unique([user_id, question_id], map: "uq_user_questions_user_question")
  @@index([question_id], map: "question_id")
}

model vocabulary {
  id                String            @id @default(uuid()) @db.VarChar(36)
  word              String            @db.VarChar(255)
  meaning_ko        String            @db.VarChar(1000)
  meaning_user_lang String?           @db.VarChar(1000)
  level             Int               @db.TinyInt
  tts_url           String?           @db.VarChar(500)
  is_downloaded     Int               @default(0) @db.TinyInt
  updated_at        BigInt
  user_vocabulary   user_vocabulary[]
}
